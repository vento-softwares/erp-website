# Copy to .env.local for local development (Next.js and drizzle-kit both read it).
# In Vercel, add the same keys under Project Settings -> Environment Variables.

# --- Required -------------------------------------------------------------

# Neon -> your project -> Connect. Use the pooled connection string.
# Tip: point local dev at a Neon `dev` branch, production at `main`.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Password for /admin. At least 12 characters; use a long random value in production.
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Recommended ----------------------------------------------------------

# Loops (loops.so) -> Settings -> API. Without it signups still save, but no
# contact/event is sent to Loops (an error is logged).
LOOPS_API_KEY=

# PostHog project settings -> Project API Key (public by design). Leave the key
# empty to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Recommended for production (optional locally) ------------------------

# Upstash Redis (console.upstash.com) -> REST API. Enables a real global rate
# limit; without it limiting is per serverless instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile). Bot check on the
# waitlist form. Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
